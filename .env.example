# Copy to `.env` at the repo root and fill in. `.env` is gitignored; this file is not.
#
# Nothing here is needed to build, typecheck, or run the test suite — the whole suite is
# offline. These keys unlock the two measurements that need a real model:
#
#   pnpm --filter @onchain-guard/bench bench -- --provider anthropic --runs 30
#   pnpm --filter @chainwards/eliza demo:ab -- --model anthropic
#
# Both scripts load this file automatically via node's --env-file-if-exists, so there is
# nothing to source and no dotenv dependency. Exported shell variables still win over it.

# Required for the hijack half of both the benchmark and the A/B demo.
ANTHROPIC_API_KEY=

# Only needed for the cross-vendor comparison (four arms, one per vendor). The benchmark
# has no provider for these yet — leave them empty until that lands.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
