{
  "name": "chainward",
  "version": "0.4.0",
  "type": "module",
  "license": "MIT",
  "author": "fl0wizy <190269791+fl0wizy@users.noreply.github.com> (https://github.com/fl0wizy)",
  "description": "Scan and sanitize attacker-writable on-chain text before it reaches an LLM. Zero-dependency prompt-injection guard for web3 AI agents — library, and a drop-in proxy.",
  "keywords": [
    "agent-security",
    "ai-agent",
    "blockchain",
    "cli",
    "guardrail",
    "llm-proxy",
    "llm-security",
    "onchain",
    "prompt-injection",
    "sanitization",
    "wallet-agent",
    "web3"
  ],
  "homepage": "https://github.com/onchain-guard/ChainWard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onchain-guard/ChainWard.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/onchain-guard/ChainWard/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy.d.ts",
        "default": "./dist/proxy.js"
      },
      "require": {
        "types": "./dist/proxy.d.cts",
        "default": "./dist/proxy.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "PROXY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "npx tsx --test test/*.test.ts",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "bin": {
    "chainward": "./dist/cli.js"
  }
}
