{
  "name": "@chainwards/eliza",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "ChainWard plugin for ElizaOS — guards attacker-writable on-chain text before it reaches the model.",
  "keywords": [
    "elizaos",
    "elizaos-plugin",
    "prompt-injection",
    "ai-agent",
    "agent-security",
    "web3",
    "guardrail"
  ],
  "homepage": "https://github.com/onchain-guard/ChainWard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onchain-guard/ChainWard.git",
    "directory": "packages/eliza"
  },
  "bugs": {
    "url": "https://github.com/onchain-guard/ChainWard/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "npx tsx --test test/*.test.ts",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chainward": "workspace:*"
  },
  "peerDependencies": {
    "@elizaos/core": ">=1.7.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "tsup": "^8.5.1"
  }
}
